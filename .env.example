PORT=3000
# Option A: full URI (recommended for Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<appName>
# Option B: build URI from parts (auto-URL-encodes user/pass)
MONGODB_HOST=<cluster-host>
MONGODB_DB=<database>
MONGODB_USER=<username>
MONGODB_PASS=<password>
MONGODB_OPTIONS=retryWrites=true&w=majority
MONGODB_APP_NAME=<appName>
SESSION_SECRET=your_session_secret
BASE_URL=https://<your-vercel-domain>.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Cứu Hộ Máy Tính VinhUni <your_email@gmail.com>"
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10
