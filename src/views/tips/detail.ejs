<section class="container tip-detail">
  <div class="section-head tip-detail-head">
    <h2><%= tip.title %></h2>
    <p><%= tip.excerpt %></p>
  </div>
  <div class="card tip-detail-card">
    <img class="tip-detail-thumb" src="<%= (!tip.thumbnail || tip.thumbnail === '/images/og-default.png') ? '/images/banner.jpg' : tip.thumbnail %>" alt="<%= tip.title %>">
    <div class="tip-content">
      <%- tip.content %>
    </div>
    <p class="tip-meta">Danh mục: <%= tip.category?.name || '' %> | Tags: <%= (tip.tags && tip.tags.length) ? tip.tags.map(t => t.name).join(', ') : '' %></p>
  </div>
  <section style="margin-top:2em;">
    <h3>Bài liên quan</h3>
    <div class="card-list">
      <% related.forEach(r => { %>
        <div class="card">
          <a href="/tips/<%= r.slug %>">
            <img src="<%= (!r.thumbnail || r.thumbnail === '/images/og-default.png') ? '/images/banner.jpg' : r.thumbnail %>" alt="<%= r.title %>">
            <h4><%= r.title %></h4>
          </a>
        </div>
      <% }) %>
    </div>
  </section>
</section>
