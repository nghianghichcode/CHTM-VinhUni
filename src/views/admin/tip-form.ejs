<section>
  <h2><%= tip ? 'Cập nhật Tip' : 'Thêm Tip' %></h2>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css">
  <form method="post" action="/admin/tips/save" class="card" enctype="multipart/form-data">
    <% if (tip) { %>
      <input type="hidden" name="id" value="<%= tip._id %>">
    <% } %>
    <input type="text" name="title" placeholder="Tiêu đề" value="<%= tip?.title || '' %>" required>
    <input type="text" name="excerpt" placeholder="Tóm tắt" value="<%= tip?.excerpt || '' %>" required>
    <div class="admin-field">
      <label>Ảnh đại diện (URL)</label>
      <input type="text" name="thumbnail" placeholder="Link ảnh" value="<%= tip?.thumbnail || '' %>">
    </div>
    <div class="admin-field">
      <label>Ảnh đại diện (Upload)</label>
      <input type="file" name="thumbnailFile" accept="image/*">
      <% if (tip?.thumbnail) { %>
        <div class="thumb-preview">
          <img src="<%= tip.thumbnail %>" alt="Thumbnail">
          <label class="remove-thumb"><input type="checkbox" name="removeThumbnail"> Xoá ảnh hiện tại</label>
        </div>
      <% } %>
    </div>
    <select name="category" required>
      <option value="">Chọn danh mục</option>
      <% categories.forEach(cat => { %>
        <option value="<%= cat._id %>" <%= tip && tip.category?.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
      <% }) %>
    </select>
    <select name="tags" multiple>
      <% tags.forEach(tag => { %>
        <option value="<%= tag._id %>" <%= tip && tip.tags?.map(t => t.toString()).includes(tag._id.toString()) ? 'selected' : '' %>><%= tag.name %></option>
      <% }) %>
    </select>
    <select name="status">
      <option value="draft" <%= tip?.status === 'draft' ? 'selected' : '' %>>Draft</option>
      <option value="published" <%= tip?.status === 'published' ? 'selected' : '' %>>Published</option>
    </select>
    <label style="display:flex; gap:0.5em; align-items:center;">
      <input type="checkbox" name="isFeatured" <%= tip?.isFeatured ? 'checked' : '' %>> Nổi bật
    </label>
    <input type="hidden" name="content" id="content-input" value="">
    <div class="editor-wrapper">
      <div id="editor"></div>
    </div>
    <button type="submit" class="btn">Lưu</button>
  </form>
  <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
  <script>
    const quill = new Quill('#editor', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ['bold', 'italic', 'underline', 'strike'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['link', 'image'],
          ['clean']
        ]
      }
    });

    const initialContent = <%- JSON.stringify(tip?.content || '') %>;
    if (initialContent) quill.root.innerHTML = initialContent;

    async function uploadImage(file) {
      const formData = new FormData();
      formData.append('image', file);
      const res = await fetch('/admin/uploads/tip-image', {
        method: 'POST',
        body: formData
      });
      if (!res.ok) throw new Error('Upload failed');
      const data = await res.json();
      return data.url;
    }

    quill.getModule('toolbar').addHandler('image', () => {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.click();
      input.onchange = async () => {
        const file = input.files[0];
        if (!file) return;
        try {
          const url = await uploadImage(file);
          const range = quill.getSelection(true);
          quill.insertEmbed(range.index, 'image', url);
          quill.setSelection(range.index + 1, 0);
        } catch (err) {
          alert('Upload ảnh thất bại');
        }
      };
    });

    document.querySelector('form').addEventListener('submit', () => {
      document.getElementById('content-input').value = quill.root.innerHTML;
    });
  </script>
</section>
