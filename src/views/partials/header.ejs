<header class="site-header">
  <div class="header-lanterns" aria-hidden="true">
    <div class="lantern-wrap left">
      <div class="lantern-string"></div>
      <div class="lantern"></div>
    </div>
    <div class="lantern-wrap right">
      <div class="lantern-string"></div>
      <div class="lantern"></div>
    </div>
  </div>
  <div class="container flex-between">
    <a href="/" class="logo">
      <img src="/images/logo_transparent.png" alt="Logo Cứu hộ máy tính VinhUni" height="44">
      <div class="logo-text">
        <span class="logo-title">Cứu hộ máy tính VinhUni</span>
        <span class="logo-slogan" id="logo-slogan" data-alt="Chúc mừng năm mới">Lập trình yêu thương</span>
      </div>
    </a>

    <button class="mobile-menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false">☰</button>

    <nav class="main-nav" aria-label="Điều hướng chính">
      <div class="drawer-header" aria-hidden="true">
        <div class="drawer-brand">
          <img src="/images/logo_transparent.png" alt="Logo" class="drawer-logo" height="36" width="36">
          <div class="drawer-text">
            <span class="drawer-label">Menu</span>
            <span class="drawer-sub">Cứu hộ máy tính VinhUni</span>
          </div>
        </div>
        <button class="drawer-close" type="button" aria-label="Đóng menu">✕</button>
      </div>
      <a href="/tips">Thủ thuật</a>
      <a href="/rescue">Cứu hộ</a>
      <a href="/faq">FAQ</a>
      <a href="/contact">Liên hệ</a>

      <div class="header-info" aria-live="polite">
        <div class="header-time" id="header-time">--:--:--</div>
        <div class="header-meta">
          <span id="header-date">--</span>
          <span class="header-weather">
            <span id="header-weather-icon" aria-hidden="true">⛅</span>
            <span id="header-temp">--°C</span>
          </span>
        </div>
      </div>

      <% if (user) { %>
        <% const userInitial = (user.name || 'U').trim()[0]?.toUpperCase(); %>
        <span class="header-user" aria-label="Người dùng đăng nhập">
          <% if (user.avatarUrl) { %>
            <img class="header-user__avatar" src="<%= user.avatarUrl %>" alt="Ảnh đại diện">
          <% } else { %>
            <span class="header-user__avatar" aria-hidden="true"><%= userInitial %></span>
          <% } %>
          <span class="header-user__greet">Xin chào,</span>
          <span class="header-user__name"><%= user.name %></span>
        </span>
      <% } else { %>
        <a href="/auth/login" class="btn">Đăng nhập</a>
      <% } %>

      <label class="theme-switch" title="Chuyển dark mode">
        <input type="checkbox" id="dark-toggle" aria-label="Chuyển chế độ sáng/tối">
        <span class="slider">
          <span class="star star-1"></span>
          <span class="star star-2"></span>
          <span class="star star-3"></span>
          <svg viewBox="0 0 16 16" class="cloud" aria-hidden="true" focusable="false">
            <path d="M4 9c-1.7 0-3 1.3-3 3s1.3 3 3 3h7.5c1.66 0 3-1.34 3-3 0-1.25-.76-2.32-1.84-2.77A3.5 3.5 0 0 0 9.5 7c-1.54 0-2.84.99-3.31 2.37C5.86 9.13 4.96 9 4 9Z" fill="currentColor" />
          </svg>
        </span>
      </label>

      <% if (user) { %>
        <a href="/profile">Tài khoản</a>
        <a href="/auth/logout">Đăng xuất</a>
      <% } %>
    </nav>

    <div class="nav-overlay" aria-hidden="true"></div>
  </div>
</header>
