<!DOCTYPE html>
<html lang="vi" class="<%= (locals.darkMode ? 'dark' : '') %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= meta?.title || 'Cứu Hộ Máy Tính VinhUni' %></title>
  <meta name="description" content="<%= meta?.description || '' %>">
  <meta property="og:title" content="<%= meta?.title || '' %>">
  <meta property="og:description" content="<%= meta?.description || '' %>">
  <meta property="og:image" content="<%= meta?.image || '/images/og-default.png' %>">
  <meta property="og:url" content="<%= meta?.url || '' %>">
  <link rel="icon" href="/images/logo_transparent.png" type="image/png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dark.css" id="dark-css" disabled>
  <script src="/js/dark-init.js"></script>
  <script src="/js/darkmode.js" defer></script>
  <script src="/js/main.js" defer></script>
</head>
<body class="<%= bodyClass || '' %>">
  <canvas id="fireworks-canvas" aria-hidden="true"></canvas>
  <%- include('../partials/header') %>
  <main>
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
