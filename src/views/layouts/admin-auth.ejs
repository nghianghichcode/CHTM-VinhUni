<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Admin - <%= meta?.title || 'Login' %></title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/js/dark-init.js"></script>
  <script src="/js/darkmode.js" defer></script>
</head>
<body class="admin-auth">
  <div class="admin-auth-toggle">
    <label class="admin-theme-switch" title="Chuyển dark mode">
      <input type="checkbox" id="dark-toggle" aria-label="Chuyển chế độ sáng/tối">
      <span class="track"><span class="dot"></span></span>
    </label>
  </div>
  <main class="auth-wrapper">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
</body>
</html>
