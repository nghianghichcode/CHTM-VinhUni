<div class="auth-page-wrapper">
  <div class="floating-lanterns" aria-hidden="true">
    <span style="--i:1"></span>
    <span style="--i:2"></span>
    <span style="--i:3"></span>
    <span style="--i:4"></span>
    <span style="--i:5"></span>
  </div>
  <div class="golden-rings" aria-hidden="true"></div>

  <div class="container auth-container">
    <div class="auth-layout">
      <div class="auth-promo">
        <div class="tet-badge">TẾT BÍNH NGỌ 2026</div>
        <h1 class="tet-title">Tạo mật khẩu mới</h1>
        <p class="tet-desc">Đặt lại mật khẩu để tiếp tục sử dụng dịch vụ.</p>
      </div>

      <div class="auth-card">
        <div class="auth-header">
          <p class="auth-chip">Bảo mật tài khoản</p>
          <h2>Đặt lại mật khẩu</h2>
          <p>Nhập mật khẩu mới (tối thiểu 6 ký tự).</p>
        </div>

        <form method="post" action="/auth/reset-password" class="auth-form">
          <div class="form-group">
            <label for="password">Mật khẩu mới</label>
            <input type="password" id="password" name="password" placeholder="........" required>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-tet">Cập nhật mật khẩu</button>
        </form>

        <div class="auth-footer">
          <p>Đã nhớ mật khẩu? <a href="/auth/login" class="link-tet">Đăng nhập</a></p>
        </div>
      </div>
    </div>
  </div>
</div>
