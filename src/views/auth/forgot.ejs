<div class="auth-page-wrapper">
  <div class="floating-lanterns" aria-hidden="true">
    <span style="--i:1"></span>
    <span style="--i:2"></span>
    <span style="--i:3"></span>
    <span style="--i:4"></span>
    <span style="--i:5"></span>
  </div>
  <div class="golden-rings" aria-hidden="true"></div>

  <div class="container auth-container">
    <div class="auth-layout">
      <div class="auth-promo">
        <div class="tet-badge">TẾT BÍNH NGỌ 2026</div>
        <h1 class="tet-title">Khôi phục mật khẩu</h1>
        <p class="tet-desc">Nhập email để nhận mã OTP và đặt lại mật khẩu của bạn.</p>
      </div>

      <div class="auth-card">
        <div class="auth-header">
          <p class="auth-chip">Bảo mật nâng cao</p>
          <h2>Quên mật khẩu</h2>
          <p>Chúng tôi sẽ gửi mã OTP đến email của bạn.</p>
        </div>

        <form method="post" action="/auth/forgot" class="auth-form">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@email.com" required>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-tet">Gửi mã OTP</button>
        </form>

        <div class="auth-footer">
          <p>Đã nhớ mật khẩu? <a href="/auth/login" class="link-tet">Đăng nhập</a></p>
        </div>
      </div>
    </div>
  </div>
</div>
