<div class="auth-page-wrapper">
  <div class="floating-lanterns" aria-hidden="true">
    <span style="--i:1"></span>
    <span style="--i:2"></span>
    <span style="--i:3"></span>
    <span style="--i:4"></span>
    <span style="--i:5"></span>
  </div>
  <div class="golden-rings" aria-hidden="true"></div>

  <div class="container auth-container">
    <div class="auth-layout">
      <div class="auth-promo">
        <div class="tet-badge">TẾT BÍNH NGỌ 2026</div>
        <h1 class="tet-title">Xác thực OTP</h1>
        <p class="tet-desc">Nhập mã OTP đã gửi tới <strong><%= emailMasked %></strong>.</p>
      </div>

      <div class="auth-card">
        <div class="auth-header">
          <p class="auth-chip">Bảo mật 6 số</p>
          <h2>Nhập mã OTP</h2>
          <p>Mã OTP chỉ có hiệu lực trong vài phút.</p>
        </div>

        <form method="post" action="/auth/verify-otp" class="auth-form">
          <input type="hidden" name="purpose" value="<%= purpose %>">
          <% if (purpose === 'reset' && emailValue) { %>
            <input type="hidden" name="email" value="<%= emailValue %>">
          <% } %>
          <div class="form-group">
            <label for="otp">Mã OTP</label>
            <input type="text" id="otp" name="otp" placeholder="123456" inputmode="numeric" maxlength="6" required>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-tet">Xác thực</button>
        </form>

        <div class="auth-footer">
          <% if (purpose === 'register') { %>
            <p>Chưa nhận được mã? <a href="/auth/resend-otp?purpose=register" class="link-tet">Gửi lại OTP</a></p>
            <p><a href="/auth/register" class="link-tet">Quay lại</a></p>
          <% } else { %>
            <p>Chưa nhận được mã? <a href="/auth/resend-otp?purpose=reset" class="link-tet">Gửi lại OTP</a></p>
            <p><a href="/auth/forgot" class="link-tet">Quay lại</a></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
